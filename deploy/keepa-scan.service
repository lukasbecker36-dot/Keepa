[Unit]
Description=Keepa UK sourcing scan (nightly)
After=network-online.target
Wants=network-online.target
# A silent failure is the worst outcome: the operator believes a scan ran when
# it did not. NOTE this belongs in [Unit] -- systemd ignores it in [Service]
# with only a log warning, which is how it sat dead for the first live night.
OnFailure=keepa-scan-failed.service

[Service]
Type=oneshot
WorkingDirectory=/opt/keepa
# The API key. Mode 600, never in the repo -- same convention as hyperaster.
EnvironmentFile=/opt/keepa/.env
# --nightly uses the lower token reserve so the scheduled run takes priority
# over any ad-hoc query. The bucket belongs to the API key, not the process.
ExecStart=/opt/keepa/.venv/bin/python run.py --strategy s02 --nightly --notify
ExecStart=/opt/keepa/.venv/bin/python run.py --strategy s01 --nightly --notify
ExecStart=/opt/keepa/.venv/bin/python run.py --strategy s03 --nightly --notify
# A scan is mostly SLEEPING on token refill at 5/min, not computing. Give it
# room to finish rather than killing a run that is waiting legitimately.
# Three strategies now, each pacing against the same 300-token bucket at
# 5/min. Budget roughly: s02 ~365, s01 ~244, s03 ~300 -- about 3 hours of
# mostly-sleeping wall clock.
TimeoutStartSec=6h
Nice=10
# Keep well clear of the trading services sharing this box.
CPUWeight=20
IOWeight=20
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
