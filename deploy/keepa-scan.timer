[Unit]
Description=Run the Keepa sourcing scan nightly

[Timer]
# 01:30 Europe/London. Well clear of the hyperaster services' busy hours, and
# it leaves the whole night for token refill at 5/min.
OnCalendar=*-*-* 01:30:00
Persistent=true
# The scan is not time-critical; jitter avoids colliding with anything else
# that wakes on the half hour.
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
